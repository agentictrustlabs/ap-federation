        "apps/**/*.{ts,tsx}"
      ],
      "packagesGlob": "packages/*/src/**/*.ts",
      "wireAllowed": []
    },
    "demoPersonOrgDistinct": {
      "skip": "ap-federation carries no persona roster yet \u2014 enable when @agenticprimitives-demo/estate is consumed (spec 399 \u00a72.6)"
    },
    "rulesDrift": {
      "cursorRules": ".cursor/rules",
      "lock": "agentic.lock.json",
      "agentsMd": "AGENTS.md",
      "claudeMd": "CLAUDE.md"
    },
    "lockCoherent": {
