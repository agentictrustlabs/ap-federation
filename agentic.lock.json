  "doctor": {
    "webNoDirectMcp": {
      "browserApps": [],
      "allowMarkers": [
        "@external-mcp-client-demo"
      ]
    },
    "noPrivateKeys": {
      "roots": [
        "apps",
        "examples"
      ],
      "allowedIn": [
        {
          "file": "apps/projector/src/anchor.ts",
          "reason": "The projector signs the estate's anchoring transactions with the estate's projection-signer key (federation.yaml `signerKeyEnv`), read from the environment at run time and never from the tree. F1 holds it on an operator's machine; F2 moves it into the estate's .registry service agent (DEPLOYER.md). The one place the key becomes an account is here."
        }
      ],
      "toleratedEnvNames": []
    },
    "noHmacHomeBridge": {
      "dir": "apps",
      "hmacCall": "bridgeInteractions",
      "sessionRpcCall": "callInteractions",
      "ceilings": {
        "hmac": 0,
        "total": 0
      }
    },
    "noCrossSubjectVaultReads": {
      "roots": [],
      "exemptFiles": [
        "self-only.ts"
      ],
      "gate": "subjectOfRead|routedSubjectFor"
    },
    "failOpenKnobs": {
      "roots": [
        "apps",
        "examples"
      ],
      "allowlist": []
    },
    "internalMarkerSplit": {
      "src": "apps",
      "secret": "A2A_CUSTODY_BRIDGE_SECRET",
      "marker": "x-ap-internal",
      "budget": {}
    },
    "custodianCoverage": {
      "skip": "ap-federation carries no Home custody surface yet \u2014 enable when a Home moves in (specs 294/295)"
    },
    "archetypeCatalog": {
      "skip": "ap-federation carries no archetype catalog yet \u2014 enable when a Home moves in (spec 354 \u00a73)"
    },
    "capabilityVocabulary": {
