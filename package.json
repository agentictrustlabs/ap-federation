{
  "name": "ap-federation",
  "version": "0.0.0",
  "private": true,
  "description": "ap-federation \u2014 a product repository on published @agenticprimitives/* packages (ADR-0063). Generated by @agenticprimitives/create-app 0.0.0-alpha.22, template product-repo 2026-09-16.1.",
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=9"
  },
  "scripts": {
    "doctor": "ap doctor",
    "doctor:rules": "ap doctor --rules",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test && pnpm check:federation && ap doctor && pnpm check:public-links",
    "projector": "tsx apps/projector/bin/projector.mts",
    "live-gates": "ap test --live-gates live-gates.json",
    "conform:a2a": "ap conform a2a",
    "conform:mcp": "ap conform mcp",
    "upgrade:canary": "ap upgrade --canary",
    "upgrade:pin": "ap upgrade --pin",
    "check:public-links": "node scripts/check-public-links.mjs",
    "check:federation": "tsx scripts/check-federation.mts",
    "site:deploy": "pnpm --filter @ap-federation/site deploy:faithnet",
    "gate:site": "tsx scripts/gate-federation-site.mts",
    "door:deploy": "pnpm --filter @ap-federation/door deploy:impact-agent && pnpm --filter @ap-federation/door deploy:faithnet",
    "gate:door": "tsx scripts/gate-f2-door.mts",
    "gate:twin": "tsx scripts/gate-f3-twin.mts",
    "nanda": "pnpm --filter @ap-federation/nanda-adapter project",
    "projector:deploy": "pnpm --filter @ap-federation/projector deploy:faithnet",
    "gate:freshness": "tsx scripts/gate-projector-freshness.mts",
    "gate:vault-record": "tsx scripts/gate-vault-record.mts",
    "gate:pay-outward": "tsx scripts/gate-f3-pay-outward.mts",
    "gate:predicate": "tsx scripts/gate-predicate-visitor.mts",
    "setup:predicate": "tsx scripts/setup-predicate-issuer.mts",
    "keys:openac": "sh scripts/fetch-openac-keys.sh",
    "setup:predicate-vault": "tsx scripts/setup-predicate-holder-vault.mts"
  },
  "devDependencies": {
    "@agenticprimitives/a2a": "0.0.0-alpha.35",
    "@agenticprimitives/admission": "0.0.0-alpha.14",
    "@agenticprimitives/attestations": "0.0.0-alpha.33",
    "@agenticprimitives/delegation": "1.0.0-alpha.37",
    "@agenticprimitives/devkit": "0.0.0-alpha.22",
    "@agenticprimitives/estate-projection": "0.0.0-alpha.12",
    "@agenticprimitives/evaluation": "0.0.0-alpha.8",
    "@agenticprimitives/key-custody": "1.0.0-alpha.37",
    "@agenticprimitives/mcp-protocol": "0.0.0-alpha.4",
    "@agenticprimitives/privacy-credentials": "0.0.0-alpha.14",
    "@agenticprimitives/privacy-credentials-openac": "0.0.0-alpha.2",
    "@agenticprimitives/verification-receipts": "0.0.0-alpha.14",
    "openac-sdk": "5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "viem": "2.52.2",
    "vitest": "^4.1.8",
    "yaml": "2.8.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "openac-sdk@5.0.0": "patches/openac-sdk@5.0.0.patch"
    }
  }
}
