    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "viem": "2.52.2",
    "vitest": "^4.1.8",
    "yaml": "2.8.1",
    "@agenticprimitives/delegation": "1.0.0-alpha.34",
    "@agenticprimitives/admission": "0.0.0-alpha.13"
  }
